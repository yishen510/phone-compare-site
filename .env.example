# Copy this file to .env on the backend host; never commit .env.
# Rotate any API key that has appeared in chat, screenshots, or source control.
HAINAN_API_KEY=replace_with_rotated_hainan_api_key
HAINAN_REQUEST_FROM=phone_compare_site
HAINAN_QUERY_PROCESS=1
HAINAN_RESULT_SIZE=20
HAINAN_FIELDS=
HAINAN_MAX_QUERIES_PER_RESPONSE=5
HAINAN_MIN_REQUEST_INTERVAL_SECONDS=0.6
# Upstream request timeout in seconds (default 15).
HAINAN_HTTP_TIMEOUT_SECONDS=15
# Per-IP limit for /api/prices (default 40 requests/minute).
PHONE_API_RATE_LIMIT_PER_MINUTE=40
PHONE_QUOTE_CACHE_TTL_SECONDS=1800
PHONE_EMPTY_QUOTE_CACHE_TTL_SECONDS=600
HOST=127.0.0.1
PORT=8000
PHONE_CORS_ORIGIN=
# Test-only override for the upstream URL; keep unset in production.
# HAINAN_API_URL=https://gw-openapi.zhidemai.com/hj-search/discount/v2
